node_modules/
**/build/
# Leftovers of the retired FFFrames layout (its build cache and paired comparison renders).
/fframes/
.DS_Store
*.log
.env
.env.*
# Generated media in the bundled examples/templates (regenerate with `clearframe voice|music --draft`)
examples/**/assets/
templates/*/assets/
recipes/*/assets/
# Review state (revisions, notes, previews) made while working on the bundled examples.
examples/**/review/
recipes/*/review/

# Retired project media stays local.
archive/browser/examples/*/assets/
archive/browser/templates/*/assets/
archive/browser/recipes/*/assets/
archive/comparison/examples/paired/assets/vo/
archive/comparison/examples/paired/assets/music/

# Variable sources for the display voices are fetched by scene/native/tools/generate-fonts.py, hash-checked, not committed.
film/assets/fonts/source/*
!film/assets/fonts/source/Inter.ttf

# Reproducible Python bytecode from procedural recipe inspection.
__pycache__/
*.pyc

# Renders, review evidence and receipts are outputs, not library assets. Keep them in build/ or a
# project's own folder; test/repo-hygiene.test.mjs fails if binaries land outside the allowlist.
**/evidence/
**/specimens/
**/*-receipt.json

# Real client and personal projects for the viewer; never committed.
real-examples/

# The browser studio: films made in the browser, and its private runtime state (OpenCode sessions,
# saved provider credentials, bridge token). Never committed; see docs/agent-studio.md.
/projects/
.clearframe/

# Local mock recordings for the enterprise bench (rebuilt by make-episode.mjs)
bench/**/*.wav
