       "icon": "message",
       "color": "positive",
       "enter": "none"
      },
      {
       "id": "review",
       "icon": "star",
       "color": "accent2",
       "enter": "drop"
      },
      {
       "id": "mail2",
       "icon": "mail",
       "color": "accent",
       "enter": "drop"
