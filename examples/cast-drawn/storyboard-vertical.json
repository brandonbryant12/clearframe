        "mail",
        "mail2"
       ],
       "say": "email"
      },
      {
       "form": "wave",
       "ids": [
        "chat",
        "chat2"
       ],
       "say": "chat"
      },
      {
       "form": "wave",
       "ids": [
        "review"
       ],
       "say": "reviews"
      }
     ]
    }
   }
  },
  {
