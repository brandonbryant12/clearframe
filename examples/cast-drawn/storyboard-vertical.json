        "mail2",
        "chat2"
       ],
       "say": "copies"
      },
      {
       "form": "exit",
       "ids": [
        "mail2",
        "chat2"
       ],
       "say": "aside",
       "dur": 0.9
      }
     ]
    }
   }
  },
  {
   "id": "rank",
   "block": "canvas",
