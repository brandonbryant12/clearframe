      {
       "form": "hero",
       "hero": "patch",
       "scale": 1.5,
       "at": 0.2
      },
      {
       "form": "ring",
       "ids": [
        "mail",
        "chat2",
        "review",
        "mail2",
        "chat"
       ],
       "say": "everyone",
       "spread": 460,
       "dur": 1
      },
      {
       "form": "mark",
       "mark": "arrow",
       "ids": [
        "patch"
       ],
       "to": [
        "mail2",
        "chat2"
       ],
       "say": "hears",
       "color": "ink"
      }
     ]
    }
   }
  }
 ]
}
