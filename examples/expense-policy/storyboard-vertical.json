        "sketch": "share",
        "sketchParams": {
          "count": 31,
          "tone": "negative"
        },
        "sketchText": {
          "WHAT": "of expense claims came back last year"
        },
        "sketchSay": {
          "COUNT": "thirty-one",
          "ISOLATE": "Almost"
        },
        "source": "Fairhaven finance operations, 2027 claims review (fictional)"
      }
    },
    {
