      "id": "report",
      "claim": "31% of expense claims were sent back in 2027, most for a missing itemised receipt",
      "source": "Fairhaven finance operations, 2027 claims review (fictional)"
    },
    {
      "id": "policy",
      "claim": "From January 1, 2028, claims are due within 30 days (was 60); itemised receipts are needed over $25; claims are made in the Fairhaven Expenses app",
      "source": "Fairhaven Travel & Expense Policy v4, effective January 1, 2028 (fictional)"
    }
  ],
  "beats": [
    {
      "id": "hook",
      "block": "canvas",
      "vo": "Last year, we sent back thirty-one percent of expense claims. Almost always, for the receipt.",
