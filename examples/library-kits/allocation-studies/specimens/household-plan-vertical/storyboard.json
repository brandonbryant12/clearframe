  "sources": [
    {
      "claim": "Original fictional plans. Equal tiles encode a fixed declared amount, not equal risk, productivity or benefit. Listed transfers reassign an unchanged total; no returns, spending, losses, fees, arrivals or optimization are modeled. Every token retains its identity and size. The source is debited on departure and the destination credited on arrival; parked plus in-transit tokens always equal the original total. The clock is editorial, not observed transfer duration. Final bars encode counts from zero on one shared scale, with approximate shares labeled.",
      "source": "inputs.json; fframes/allocation-data.mjs v1; source and assumptions in SOURCES.md.",
      "asOf": "2026-09-30"
    }
  ],
