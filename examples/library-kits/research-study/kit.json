    "media": "media",
    "preview": "preview.html"
  },
  "requires": {
    "replay": [
      "ClearFrame native compositor",
      "research-paper palette",
      "bundled Inter fonts"
    ],
    "preparation": [
      "Node.js",
      "FFmpeg",
      "native renderer setup"
    ],
    "blender": "Optional; required only to revise or regenerate 3D media"
  },
  "editable": {
    "native": [
      "chart values",
      "dates",
      "annotation",
      "labels",
      "palette",
      "timing"
    ],
    "requiresNewAssetPass": [
      "gate geometry",
      "materials",
      "lighting",
      "camera",
      "baked motion"
    ],
    "fixedClip": [
      "Retained MP4 pixels; regenerate after source edits"
    ]
  },
  "evidence": {
    "summary": "evidence/summary.json",
