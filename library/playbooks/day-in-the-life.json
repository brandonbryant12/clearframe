{
  "order": 6,
  "title": "Follow one person through a benefit",
  "audience": "Employees who see themselves in someone like them: new hires, parents, people near retirement",
  "inputs": "One realistic person (a role, not a real employee), the moments the benefit touches in their week, the figures from the plan document and the step they take",
  "theme": "meadow",
  "type": "geometric",
  "motion": "snappy",
  "transition": "cut",
  "sfx": "subtle",
  "texture": {
    "grain": 0.05
  },
  "sources": [
    {
      "id": "plan",
      "claim": "On a $60,000 salary, 5% is $250 a month and the company adds $200",
      "source": "Example Co. benefits guide (sample: replace with your plan document)"
    }
  ],
  "note": "Persona arc: meet one person (a cast `person` with their name), follow one object of theirs (here the paycheck) through the moments the benefit touches, and end with them, changed. The person is a role, never a real employee. Replace the name, the objects, sketchText, sketchParams and sketchSay with your plan's words and figures (`clearframe sketch NAME`). See skills/clearframe-workplace/SKILL.md.",
  "beats": [
    {
      "id": "meet",
      "block": "canvas",
      "vo": "This is Priya. It's her first week, and her first paycheck is on its way.",
      "props": {
        "cast": {
          "look": "tiles",
          "objects": [
            {
              "id": "priya",
              "shape": "person",
              "color": "accent",
              "label": "Priya",
              "enter": "none"
            },
            {
              "id": "badge",
              "shape": "badge",
              "color": "accent2",
              "label": "Week one",
              "enter": "none"
            },
            {
              "id": "pay",
              "shape": "paycheck",
              "color": "positive",
              "label": "First paycheck",
              "enter": "drop"
            }
          ],
          "formations": [
            {
              "form": "line",
              "at": 0,
              "ids": [
                "priya",
                "badge"
              ]
            },
            {
              "form": "travel",
              "ids": [
                "pay"
              ],
              "to": "priya",
              "say": "paycheck"
            }
          ]
        }
      }
    },
    {
      "id": "where",
      "block": "canvas",
      "vo": "Before it reaches her, it splits: taxes, her health plan, her retirement, and what she takes home.",
      "props": {
        "source": "Example Co. benefits guide · example: a $60,000 salary",
        "sketch": "split",
        "sketchParams": {
          "parts": [
            22,
            6,
            5,
            67
          ],
          "suffix": "%",
          "total": false
        },
        "sketchText": {
          "WHOLE": "Priya's paycheck",
          "PARTONE": "Taxes",
          "PARTTWO": "Health plan",
          "PARTTHREE": "Retirement",
