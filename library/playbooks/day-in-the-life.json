    },
    {
      "id": "match",
      "block": "canvas",
      "vo": "Her five percent for retirement isn't alone. Example Co. adds four more, every paycheck.",
      "props": {
        "source": "Example Co. benefits guide",
        "sketch": "match",
        "sketchParams": {
          "you": 5,
          "match": 4,
          "suffix": "%"
