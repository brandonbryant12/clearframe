      "id": "turn",
      "block": "kinetic",
      "vo": "But the average hides who is affected most.",
      "props": {
        "mode": "stack",
        "align": "left",
        "maxWords": 5,
        "source": "",
        "emphasis": ["average", "most"],
        "emphasisStyle": "serif"
      },
      "transition": "iris"
    },
    {
      "id": "meaning",
      "block": "statement",
      "vo": "So act on the distribution, not the average.",
      "props": {
        "text": "Act on the distribution, not the average.",
        "emphasis": ["distribution"],
        "emphasisStyle": "serif",
        "align": "center",
        "source": "Illustrative sample data · replace before publishing"
      }
    },
    {
      "id": "end",
      "block": "endcard",
      "vo": "The methods and the limits are in the full report.",
      "props": {
        "support": "Start with one handoff this week.",
        "action": "Open the report",
        "source": "Illustrative sample data · replace before publishing",
        "text": "Read the whole story.",
        "align": "center"
      },
      "hold": 1
    }
  ],
  "theme": "noir",
  "backdrop": "glow",
  "motion": "gentle",
  "texture": {
    "grain": 0.35,
    "vignette": 0.5
  },
  "note": "Start from clearframe ingest --markdown report.md: it writes BRIEF.md with every figure, its sentence and its source, plus tensions and chart-ready tables. Replace every sample claim; lead with the question and the surprise, not the report's section order. Shots, not slides: the figure as a full-frame insert, the question as poster type, charts under lower thirds with a moving camera, a silence before the turn.",
  "heading": "bottom",
  "textMotion": "words",
  "transition": "cut",
  "lens": {
    "grade": "warm",
    "gradeAmount": 0.35,
    "bloom": 0.3,
    "leak": 0.1,
    "handheld": 0.15,
    "blur": 0.5
  }
}
