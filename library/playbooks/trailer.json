{
  "order": 29,
  "title": "A trailer: a cold open, a rising montage, a silence, the title and a button",
  "audience": "An audience to build anticipation in: a launch, a season, an announcement",
  "inputs": "One promise, three images of what it touches, a title, a date or call to action",
  "theme": "noir",
  "motion": "snappy",
  "transition": "cut",
  "sfx": "normal",
  "music": {
    "style": "pulse",
    "bpm": 92,
    "volume": 0.32,
    "prompt": "Cinematic trailer score: deep percussion, a pulsing synth bass and tense low strings"
  },
  "textMotion": "letters",
  "texture": {
    "grain": 0.4,
    "vignette": 0.6,
    "animate": true
  },
  "lens": {
    "letterbox": 2.39,
    "grade": "bleach",
    "gradeAmount": 0.5,
    "bloom": 0.2,
    "handheld": 0.3,
    "blur": 0.5
  },
  "note": "Shots, not slides (docs/cinema.md). Every world here belongs to this film's promise (a signal): a waveform out of the dark, power lines at dusk, a city switching on, a mast at dawn. Swap them for the places your promise touches, keep the rhythm: each montage shot shorter than the last, a black card between them, a silence with no voice, the title on the one flash, a button. Cards take a small LEAD line and one or two huge words (sketchText LEAD and CARD).",
  "beats": [
    {
      "id": "open",
      "block": "canvas",
      "vo": "It begins as a whisper.",
      "props": {
        "sketch": "signal"
      },
      "transition": "cut"
    },
    {
      "id": "card-1",
      "block": "canvas",
      "vo": "Before the noise.",
      "props": {
        "sketch": "card",
        "sketchText": {
          "LEAD": "BEFORE",
          "CARD": "THE NOISE"
        }
      }
    },
    {
      "id": "through",
      "block": "canvas",
      "transition": "cut",
      "vo": "It moves through every wire,",
      "props": {
        "sketch": "wires"
      }
    },
    {
      "id": "city",
      "block": "canvas",
      "vo": "every city,",
      "hold": 0.5,
      "props": {
        "sketch": "citygrid"
      }
    },
    {
      "id": "card-2",
      "block": "canvas",
      "transition": "cut",
      "vo": "One idea.",
      "props": {
        "sketch": "card",
        "sketchText": {
          "LEAD": "ONE",
          "CARD": "IDEA"
        }
      }
    },
    {
      "id": "dawn",
      "block": "canvas",
      "transition": "cut",
      "vo": "and every morning after.",
      "props": {
        "sketch": "mast"
      }
    },
    {
      "id": "silence",
      "block": "canvas",
      "duration": 1.3,
      "props": {
        "sketch": "flatline"
      }
    },
    {
      "id": "title",
      "block": "canvas",
      "hold": 2.0,
      "transition": "flash",
      "vo": "Signal.",
      "props": {
        "sketch": "title",
        "sketchText": {
          "TITLE": "SIGNAL",
          "A LINE OF CONTEXT": "A FILM ABOUT WHAT CONNECTS US"
        }
      }
    },
    {
      "id": "button",
      "block": "canvas",
      "vo": "Coming this fall.",
      "hold": 0.6,
      "props": {
        "sketch": "card",
        "sketchText": {
          "LEAD": "COMING",
          "CARD": "THIS FALL"
        }
      }
    }
  ]
}
