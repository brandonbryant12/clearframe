{
  "name": "clearframe",
  "version": "0.4.0",
  "description": "Agent-directed motion graphics with a native GPU renderer (Skia on Metal): display typography, honest animated charts, measured speech-following text and selective Google media.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "clearframe": "engine/cli.mjs"
  },
  "scripts": {
    "cf": "node engine/cli.mjs",
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "test:native": "node --test --test-concurrency=2 test/native.test.mjs test/scene-engine.test.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "verify:pipeline": "node scripts/verify-pipeline.mjs",
    "verify:sculptures": "node scripts/verify-sculptures.mjs"
  },
  "engines": {
    "node": ">=20.10"
  },
  "keywords": [
    "motion-graphics",
    "video",
    "agent-skills",
    "claude",
    "gemini",
    "tts",
    "lyria",
    "veo",
    "explainer",
    "skia",
    "kinetic-text"
  ],
  "files": [
    "engine",
    "film/*.mjs",
    "film/*.md",
    "film/assets",
    "scene",
    "skills",
    "library",
    "recipes",
    "examples",
    "schema",
    "docs",
    "scripts",
    "CHANGELOG.md",
    "!examples/*/build",
    "!recipes/*/build"
  ],
  "dependencies": {
    "@opencode/cli": "2.0.24",
    "@opencode/client": "2.0.24",
    "@opencode/plugin": "2.0.24"
  }
}
