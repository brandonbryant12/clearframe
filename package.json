{
  "name": "clearframe",
  "version": "0.4.0",
  "description": "Agent-directed motion graphics with a native FFFrames renderer: display typography, honest animated charts, measured speech-following text and selective Google media.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "clearframe": "engine/cli.mjs"
  },
  "scripts": {
    "cf": "node engine/cli.mjs",
    "cf:fframes": "node engine/cli.mjs",
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "test:fframes": "node --test --test-concurrency=2 test/native.test.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "verify:pipeline": "node scripts/verify-pipeline.mjs",
    "verify:sculptures": "node scripts/verify-sculptures.mjs"
  },
  "engines": {
    "node": ">=20.10"
  },
  "keywords": [
    "motion-graphics",
    "video",
    "agent-skills",
    "claude",
    "gemini",
    "tts",
    "lyria",
    "veo",
    "explainer",
    "fframes",
    "kinetic-text"
  ],
  "files": [
    "engine",
    "fframes/*.mjs",
    "fframes/*.md",
    "fframes/upstream.json",
    "fframes/native",
    "fframes/assets",
    "fframes/tools",
    "skills",
    "library",
    "recipes",
    "examples",
    "schema",
    "docs",
    "scripts",
    "CHANGELOG.md",
    "!examples/*/build",
    "!recipes/*/build"
  ],
  "dependencies": {}
}
