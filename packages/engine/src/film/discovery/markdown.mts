import { entries } from './catalog.mjs';
/** The whole index as compact Markdown, grouped by kind (docs/library-index.md is this output). */
export function markdown() {
  const kinds = [...new Set(entries().map((e) => e.kind))];
  return [
    '# Library index',
    '',
    'Generated by `clearframe find --index`: everything a film can be built from, one line each. Search it with `find "what you want to show"`; `find --id kind:name` prints the exact authoring. The studio agent uses the same index (`clearframe_catalog` topics `find` and `item`).',
    '',
    ...kinds.flatMap((k) => [
      `## ${k}`,
      '',
      ...entries()
        .filter((e) => e.kind === k)
        .map((e) => `- \`${e.name}\` — ${(e.about || e.title).slice(0, 160)}`),
      '',
    ]),
  ].join('\n');
}
