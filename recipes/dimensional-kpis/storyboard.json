      "id": "headline",
      "block": "canvas",
      "duration": 5.5,
      "camera": "none",
      "props": {
        "source": "Illustrative values · replace before publishing",
        "kpi": {
          "form": "pedestal",
          "label": "Quarter revenue",
          "unit": "USD millions",
          "value": 12.4,
          "prefix": "$",
          "suffix": "M",
          "decimals": 1,
          "motion": {
            "preset": "reveal",
            "duration": 0.8
          }
        }
      }
    },
    {
      "id": "comparison",
      "block": "canvas",
      "duration": 6,
      "camera": "none",
      "props": {
        "source": "Illustrative values · replace before publishing",
