{
  "version": 2,
  "title": "Dimensional data — editable native templates",
  "logline": "Dimensional data — editable native templates",
  "format": {
    "preset": "landscape",
    "fps": 30
  },
  "theme": "porcelain",
  "motion": {
    "preset": "gentle",
    "intensity": 0.65
  },
  "transition": "cut",
  "backdrop": "none",
  "chrome": false,
  "captions": false,
  "music": {},
  "sfx": "off",
  "type": "geometric",
  "sources": [
    {
      "claim": "All metrics in this demonstration are invented illustrative values.",
      "source": "Native dimensional KPI demonstration"
    }
  ],
  "continuity": {
    "maxGeneratedShare": 0.2,
    "treatment": "Restrained editorial graphics, generous space, no generated text",
    "camera": "Locked or a slow push",
    "lighting": "Soft, diffuse",
    "motion": "Slow left-to-right movement"
  },
  "beats": [
