  },
  "beats": [
    {
      "id": "hook",
      "block": "canvas",
      "vo": "Last year, almost a third of our expense claims came back.",
      "props": {
        "source": "Example Co. 2027 claims data",
        "chart": {
          "kind": "number",
          "values": [
            {
              "label": "of claims came back",
              "value": 31,
              "highlight": true
            }
          ],
          "suffix": "%",
          "box": [
            360,
            300,
            1200,
            520
          ]
        }
      }
    },
    {
      "id": "receipt",
      "block": "canvas",
      "vo": "Mostly for one reason. A receipt needs the place, every item, and the total. A card slip is not a receipt.",
      "props": {
        "source": "Example Co. expense policy",
        "sketch": "inspect",
        "sketchParams": {
          "marks": [
            "sender",
            "body",
            "link"
          ],
          "color": "positive"
        },
        "sketchText": {
          "FROM": "Harbor Grill, 14 Dock Street",
          "SUBJECT": "Receipt #4471",
          "LINE1": "2 × lunch special  $36.00",
          "LINE2": "Tax $3.10 · Total $39.10",
          "BUTTON": "Card ending 4417",
          "MARKONE": "The place",
          "MARKTWO": "Every item",
          "MARKTHREE": "Not just the card slip"
        },
        "sketchSay": {
          "ONE": "place",
          "TWO": "item",
          "THREE": "card"
        }
      }
    },
    {
      "id": "deadline",
      "block": "canvas",
      "vo": "And the window is shorter now. From the day you spend, you have thirty days to claim, not sixty.",
      "props": {
        "source": "Example Co. expense policy",
        "sketch": "deadline",
        "sketchParams": {
          "days": 31,
          "firstWeekday": 3,
          "start": 1,
          "end": 30,
          "today": 0
        },
        "sketchText": {
          "MONTH": "March",
          "OPENS": "You spend",
          "CLOSES": "Last day to claim"
        },
        "sketchSay": {
          "OPEN": "spend",
          "CLOSE": "thirty"
        }
      },
      "hold": 1.2
    },
    {
      "id": "step",
      "block": "canvas",
      "vo": "The app does the work. Open New claim, snap the receipt, check the amount, and submit.",
      "props": {
        "sketch": "portal",
        "sketchText": {
          "APP": "Example Co. Expenses",
          "STEP1": "New claim",
          "STEP2": "Snap a receipt",
          "OTHER": "Mileage",
          "FIELD": "Amount",
          "OLD": "$0.00",
          "NEW": "$39.10",
          "DONE": "Submitted: paid in about 5 business days"
        },
        "sketchSay": {
          "CLICK1": "New",
          "CLICK2": "snap",
          "CHANGE": "amount",
          "SAVE": "submit"
        }
      },
      "transition": "cut"
