          "formations": [
            {
              "form": "line",
              "say": "Itemised",
              "ids": [
                "receipt"
              ]
            },
            {
              "form": "line",
              "say": "Within",
              "ids": [
                "receipt",
                "cal"
              ]
            },
            {
              "form": "line",
              "say": "app",
              "ids": [
                "receipt",
                "cal",
                "phone"
              ]
            },
            {
              "form": "mark",
              "mark": "circle",
              "ids": [
                "phone"
              ],
              "say": "app"
            }
          ]
        }
      },
      "transition": "cut"
    }
