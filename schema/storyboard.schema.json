{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brandonbryant12/clearframe/schema/storyboard.schema.json",
  "title": "ClearFrame storyboard",
  "description": "The source of truth for a ClearFrame video: script, beats, voice, music, generated assets and sources.",
  "type": "object",
  "required": [
    "beats"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "logline": {
      "type": "string",
      "description": "The one sentence the audience should remember."
    },
    "audience": {
      "type": "string"
    },
    "format": {
      "type": "object",
      "properties": {
        "preset": {
          "enum": [
            "landscape",
            "vertical",
            "square",
            "portrait"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 16
        },
        "height": {
          "type": "integer",
          "minimum": 16
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      }
    },
    "theme": {
      "enum": [
        "paper",
        "ink",
        "ember",
        "editorial",
        "slate",
        "signal"
      ]
    },
    "budget": {
      "type": "number",
      "minimum": 0,
      "description": "USD hard cap for paid generation per command."
    },
    "voice": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "gemini"
          ]
        },
        "model": {
          "type": "string",
          "default": "gemini-3.8-flash-tts"
        },
        "voice": {
          "type": "string",
          "default": "Charon"
        },
        "style": {
          "type": "string",
          "description": "Short, constant delivery descriptor (speech_metadata.style)."
        },
        "language": {
          "type": "string"
        },
        "wpm": {
          "type": "number",
          "default": 150
        },
        "draftVoice": {
          "type": "string",
          "description": "OS voice name for --draft (macOS `say -v`)."
        }
      }
    },
    "music": {
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "properties": {
            "model": {
              "enum": [
                "lyria-3.5",
                "lyria-3-clip-preview",
                "lyria-realtime"
              ]
            },
            "prompt": {
              "type": "string"
            },
            "bpm": {
              "type": "number"
            },
            "key": {
              "type": "string"
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "duck": {
              "type": "boolean"
            },
            "fadeIn": {
              "type": "number"
            },
            "fadeOut": {
              "type": "number"
            },
            "offset": {
              "type": "number"
            },
            "file": {
              "type": "string"
            },
            "arc": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Per-chapter musical direction."
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "number"
                  },
                  "to": {
                    "type": "number"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "ending": {
              "type": "string"
            },
            "weightedPrompts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "number"
                  }
                }
              }
            },
            "density": {
              "type": "number"
            },
            "brightness": {
              "type": "number"
            },
            "scale": {
              "type": "string"
            }
          }
        }
      ]
    },
    "mix": {
      "type": "object",
      "properties": {
        "loudness": {
          "type": "number",
          "default": -14
        },
        "voiceGain": {
          "type": "number",
          "default": 1
        }
      }
    },
    "pacing": {
      "type": "object",
      "properties": {
        "lead": {
          "type": "number",
          "default": 0.25
        },
        "tail": {
          "type": "number",
          "default": 0.6
        },
        "minBeat": {
          "type": "number",
          "default": 1.6
        },
        "silentBeat": {
          "type": "number",
          "default": 2.5
        },
        "outro": {
          "type": "number",
          "default": 0
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "chapter": {
            "type": "string"
          },
          "scene": {
            "type": "string",
            "description": "Path to a scene module, e.g. scenes/hook.js"
          },
          "vo": {
            "type": "string",
            "description": "Exact narration. Inline tags like <short pause> allowed."
          },
          "visual": {
            "type": "string",
            "description": "What the eye sees as the words land; the focal point."
          },
          "style": {
            "type": "string",
            "description": "Per-beat voice style override."
          },
          "lead": {
            "type": "number",
            "description": "Seconds before the voice starts (negative = J-cut)."
          },
          "tail": {
            "type": "number"
          },
          "hold": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "sfx": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "src"
              ],
              "properties": {
                "src": {
                  "type": "string"
                },
                "at": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "description": "word:<text>[+offset] | vo | vo-end | end"
                    }
                  ]
                },
                "volume": {
                  "type": "number"
                }
              }
            }
          },
          "block": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Library block name (see `clearframe blocks`)."
          },
          "props": {
            "type": "object",
            "description": "Props for the block or scene module."
          },
          "transition": {
            "enum": [
              "auto",
              "fade",
              "dip",
              "rise",
              "push",
              "wipe",
              "blur",
              "zoom",
              "cut",
              "none"
            ],
            "description": "Transition into this beat's scene."
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "image",
              "clip",
              "sfx"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "aspect": {
            "type": "string"
          },
          "size": {
            "enum": [
              "512",
              "1K",
              "2K",
              "4K"
            ]
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "from": {
            "type": "string",
            "description": "clip: image asset id to animate (image-to-video)."
          },
          "image": {
            "type": "string"
          },
          "seconds": {
            "enum": [
              4,
              6,
              8
            ]
          },
          "resolution": {
            "enum": [
              "720p",
              "1080p",
              "4k"
            ]
          },
          "seed": {
            "type": "integer"
          },
          "file": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "asOf": {
            "type": "string"
          }
        }
      }
    },
    "backdrop": {
      "enum": [
        "dots",
        "grid",
        "ruled",
        "topo",
        "aurora",
        "none"
      ],
      "description": "Ambient background for the default composition."
    },
    "grain": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        }
      ],
      "description": "Film grain on/off or opacity."
    },
    "vignette": {
      "type": "boolean"
    },
    "chrome": {
      "oneOf": [
        {
          "enum": [
            "auto"
          ]
        },
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "chapter": {
              "type": "boolean"
            },
            "count": {
              "type": "boolean"
            },
            "progress": {
              "type": "boolean"
            }
          }
        }
      ],
      "description": "Orientation layer: chapter label, count, progress rail."
    },
    "captions": {
      "oneOf": [
        {
          "enum": [
            "auto"
          ]
        },
        {
          "type": "boolean"
        }
      ],
      "description": "Burned-in word-synced captions ('auto' = on for vertical)."
    },
    "transition": {
      "enum": [
        "auto",
        "fade",
        "dip",
        "rise",
        "push",
        "wipe",
        "blur",
        "zoom",
        "cut",
        "none"
      ],
      "description": "Default transition between scenes ('auto' = rise across chapters, fade within)."
    },
    "sfx": {
      "type": "boolean",
      "description": "Enable block sound cues (synthesized ticks, pops, whoosh, chime)."
    }
  }
}
