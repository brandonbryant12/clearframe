      "storyboard": {
        "version": 2,
        "title": "One claim, two audiences",
        "format": {
          "preset": "landscape",
          "fps": 30
        },
        "theme": "paper",
        "camera": "none",
        "texture": "none",
        "captions": false,
        "music": false,
        "sfx": false,
        "sources": [
          {
            "claim": "Example claims and audience views are illustrative.",
            "source": "Original illustrative fixture"
          }
        ],
        "beats": [
          {
            "id": "views",
            "block": "canvas",
            "duration": 9,
            "props": {
              "table": {
                "id": "claims",
                "title": "Who sees a claim",
                "source": "Illustrative expense records",
                "columns": [
                  {
                    "id": "person",
                    "label": "Employee",
                    "weight": 1.2
                  },
                  {
                    "id": "amount",
                    "label": "Amount",
                    "align": "right",
                    "weight": 0.8
                  },
                  {
                    "id": "status",
                    "label": "Status"
                  }
                ],
                "rows": [
                  {
                    "id": "r1",
                    "cells": {
                      "person": "Alex Morgan",
                      "amount": "$120",
                      "status": "Approved"
                    }
                  },
                  {
                    "id": "r2",
                    "cells": {
                      "person": "Sam Patel",
                      "amount": "$850",
                      "status": "Review"
                    }
                  },
                  {
                    "id": "r3",
                    "cells": {
                      "person": "Jordan Lee",
                      "amount": "$45",
                      "status": "Returned"
                    }
                  }
                ],
                "views": [
                  {
                    "id": "manager",
                    "label": "Managers see the full claim"
                  },
                  {
                    "id": "contractor",
                    "label": "Contractors see claim status",
                    "hide": [
                      "person",
                      "amount"
                    ]
                  }
                ],
                "show": [
                  {
                    "view": "contractor",
                    "at": 3
                  },
                  {
                    "view": "manager",
                    "at": 6
                  }
                ]
              }
            }
          }
        ]
      },
      "at": [
        1,
        4,
        7
      ],
      "takeaway": "Managers see the claim amounts; contractors see status in the same rows."
    },
