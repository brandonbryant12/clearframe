{
  "name": "detail-to-context",
  "reference": "Premium product films that open on a material detail and pull back to the place (the detail-to-place craft in issue 9); compare whether the detail is the point and the context arrives as the camera leaves it",
  "cases": [
    {
      "id": "wide",
      "storyboard": "../../../examples/detail-to-context/storyboard.json",
      "at": [0.5, 1.2, 1.9, 3.3, 6.4, 9.8],
      "takeaway": "The receipt lands (one named moment drives the drop, squash and settle), the camera opens on it and pulls back to the claim; the total is circled on its moment, then the next shot pushes in on the claim."
    },
    {
